// Dedicated Jenkins pipeline for docs-e2e — guide-accuracy
// regression for the GPF Getting Started Guide.
//
// Triggered downstream from iossifovlab/gpf/<branch>'s
// `Trigger docs-e2e` stage after the parent build's
// `Build & push prod images` stage finishes; runs for every
// branch the parent triggers from. Can also be run manually
// from the Jenkins UI with explicit BRANCH_NAME / COMMIT_SHA /
// UPSTREAM_PROJECT / UPSTREAM_BUILD / STAGE_FILTER params.
//
// Expected Jenkins job setup:
//   - Script path: docs_e2e/Jenkinsfile.docs-e2e
//   - Defined by docs_e2e/jenkins-jobs/docs_e2e.groovy as the
//     `gpf-docs-e2e` pipelineJob, seeded by the main gpf
//     Jenkinsfile's `Apply Job DSL` stage on master.
//
// Self-contained: clones the gpf monorepo at the requested
// branch/commit; copyArtifacts the conda packages
// (dist/conda/*.conda) the upstream gpf build produced;
// builds the docs-e2e driver image; runs pytest against the
// freshly-built gpf_web conda artefact in a clean Miniforge
// container; mounts the per-agent persistent gpf-grr-cache
// docker volume so hg38 demand-pulls are reused across builds.

// Zulip failure alert (seqpipe/infra#105). Builds that pass say nothing.
//
// `build-status` used to receive a "Started build" message *and* a result
// message for every build of every job — 827 messages in 48h, of which 10 were
// failures — which made it unreadable, so nobody read it. Only FAILURE and
// UNSTABLE alert now, and they tag the channel so the alert actually pushes.
//
// UNSTABLE is included deliberately: lint/type gates mark the build UNSTABLE
// rather than FAILURE, so a failure-only rule would let a regression sit
// silent until the 09:00 digest (seqpipe/infra#110).
//
// Verbatim copy of the block proven in iossifovlab/gain#809 — do not
// re-derive it.
def zulipAlert(String status, String emoji) {
    String suffix = ''
    try {
        def results = currentBuild.rawBuild.getAction(
            hudson.tasks.test.AbstractTestResultAction)
        if (results != null) {
            // failCount == 0 on a red build means nothing got as far as
            // failing a test — a teardown / sidecar / agent problem rather
            // than a code break. Saying which is what decides "re-run" vs
            // "investigate" without opening Jenkins.
            suffix = results.failCount > 0
                ? " — ${results.failCount} test(s) failed"
                : ' — no failing tests (infra/teardown)'
        }
    } catch (ignored) {
        // getAction() needs a one-time In-process Script Approval
        // (seqpipe/infra#106). Until that lands the alert still fires, just
        // without the count: the reporting must never break the report.
        suffix = ''
    }
    return "@**channel** ${emoji} " +
        "[${env.JOB_NAME} ${currentBuild.displayName}](${env.BUILD_URL}) " +
        "${status}${suffix}"
}

pipeline {
    // Pinned to a specific agent via AGENT_LABEL (default below).
    // The persistent gpf-grr-cache volume is node-local and ~15 GB,
    // seeded out of band by gpf-docs-e2e-prewarm; pinning keeps the
    // build on the agent that was actually seeded rather than any
    // `builder` node. Override AGENT_LABEL to move docs-e2e to a
    // different (seeded) agent.
    // `?:` fallback covers the first run after this param is added,
    // before the jobDsl re-seed makes params.AGENT_LABEL exist.
    agent { label "${params.AGENT_LABEL ?: 'pooh'}" }

    parameters {
        string(
            name: 'AGENT_LABEL',
            defaultValue: 'pooh',
            description: 'Agent to run on. Must be an agent seeded ' +
                'by gpf-docs-e2e-prewarm (the gpf-grr-cache volume ' +
                'is node-local). Auto-triggered builds inherit this ' +
                'default.',
        )
        string(
            name: 'BRANCH_NAME',
            defaultValue: 'master',
            description: 'Branch the upstream gpf build was ' +
                'triggered from. The pipeline checks out ' +
                'this branch unless COMMIT_SHA is set.',
        )
        string(
            name: 'COMMIT_SHA',
            defaultValue: '',
            description: 'Specific commit SHA to test (takes ' +
                'precedence over BRANCH_NAME). Empty = use ' +
                'BRANCH_NAME HEAD.',
        )
        string(
            name: 'UPSTREAM_PROJECT',
            defaultValue: '',
            description: 'Upstream Jenkins project (e.g. ' +
                'iossifovlab/gpf/master) the conda artefacts ' +
                'are copied from. Empty = fall back to ' +
                'iossifovlab/gpf/master lastSuccessful().',
        )
        string(
            name: 'UPSTREAM_BUILD',
            defaultValue: '',
            description: 'Upstream build number to copy ' +
                'conda artefacts from. Empty = use ' +
                'lastSuccessful() of UPSTREAM_PROJECT.',
        )
        string(
            name: 'GAIN_PROJECT',
            defaultValue: '',
            description: 'Jenkins project the gain-core conda ' +
                'is copied from. Empty = fall back to ' +
                'iossifovlab/gain/master lastSuccessful().',
        )
        string(
            name: 'GAIN_BUILD',
            defaultValue: '',
            description: 'gain build number to copy gain-core ' +
                'from. Empty = use lastSuccessful() of ' +
                'GAIN_PROJECT.',
        )
        string(
            name: 'STAGE_FILTER',
            defaultValue: '',
            description: 'Optional pytest -k expression to ' +
                'narrow which test files run. Empty = run all ' +
                'stages. Example: "test_main_body" to run only ' +
                'the v1 main-body suite.',
        )
    }

    options {
        timeout(time: 1, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        DRIVER_IMAGE     = "gpf-docs-e2e-driver:${env.BUILD_NUMBER}"
        // Per-agent persistent GRR cache. First build on a fresh
        // agent demand-pulls hg38 (~3 GB, ~10 min); subsequent
        // builds re-use the cache. Volume name is agent-global,
        // not build-scoped — that's the point.
        GRR_CACHE_VOLUME = "gpf-grr-cache"
        // Container-local artefact dirs:
        //   /workspace          — the gpf checkout (bind mount)
        //   /workspace/dist/conda — copied conda packages
        //   /grr-cache          — the GRR_CACHE_VOLUME
    }

    stages {
        stage('Start') {
            steps {
                script {
                    String label = params.BRANCH_NAME
                    if (params.COMMIT_SHA?.trim()) {
                        label += " @ ${params.COMMIT_SHA.take(7)}"
                    }
                    if (params.STAGE_FILTER?.trim()) {
                        label += " [${params.STAGE_FILTER}]"
                    }
                    currentBuild.displayName =
                        "#${env.BUILD_NUMBER} ${label}"
                }
            }
        }

        stage('Prepare workspace') {
            steps {
                // pytest writes JUnit + log artefacts into
                // reports/docs_e2e; the test driver writes
                // tempdirs the conftest fixtures own. Run the
                // wipe inside an alpine container as root so
                // root-owned leftovers from a previous build
                // don't trip the host-side rm.
                sh '''
                    docker run --rm -v "$PWD:/wd" -w /wd alpine \
                        rm -rf dist reports
                    mkdir -p reports/docs_e2e dist
                '''
            }
        }

        stage('Checkout') {
            steps {
                script {
                    String ref = params.COMMIT_SHA?.trim() ?:
                                 params.BRANCH_NAME
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: ref]],
                        userRemoteConfigs: [[
                            url: 'https://github.com/iossifovlab/gpf.git',
                        ]],
                        extensions: [[$class: 'CloneOption',
                                      shallow: true,
                                      noTags: true,
                                      depth: 1]],
                    ])
                }
            }
        }

        stage('Copy conda artefacts') {
            // Pull the freshly-built dist/conda/*.conda from the
            // upstream gpf build. (β)-mode install path per #871:
            // the suite tests THIS build's conda, not whatever is
            // published on the iossifovlab channel. gain-core is a
            // first-party dep of gpf-web that gpf does NOT build, so it
            // is copied separately from gain master's last build
            // (gpf#916) -- the iossifovlab channel is dropped at install
            // time, so the local channel must carry every first-party
            // package the solve needs.
            steps {
                script {
                    String project = params.UPSTREAM_PROJECT?.trim() ?:
                                     'iossifovlab/gpf/master'
                    def selector = params.UPSTREAM_BUILD?.trim() ?
                                   specific(params.UPSTREAM_BUILD) :
                                   lastSuccessful()
                    copyArtifacts(
                        filter: 'dist/conda/*.conda',
                        fingerprintArtifacts: true,
                        projectName: project,
                        selector: selector,
                    )
                    // gain-core from gain master's last build, into the same
                    // local channel. Mirrors how gpf's own CI fetches the gain
                    // wheel from gain/master lastSuccessful; here we take the
                    // conda artefact gain master archives (dist/conda/*.conda).
                    String gainProject = params.GAIN_PROJECT?.trim() ?:
                                         'iossifovlab/gain/master'
                    def gainSelector = params.GAIN_BUILD?.trim() ?
                                       specific(params.GAIN_BUILD) :
                                       lastSuccessful()
                    copyArtifacts(
                        filter: 'dist/conda/gain-core-*.conda',
                        fingerprintArtifacts: true,
                        projectName: gainProject,
                        selector: gainSelector,
                    )
                }
                sh '''
                    ls -la dist/conda/
                    # On-disk conda filenames use the dashed package name
                    # (gpf-web, gain-core) regardless of the underscored
                    # python module. With the iossifovlab channel dropped at
                    # install time there is no published fallback, so fail
                    # loud here if either first-party artefact is missing --
                    # otherwise it surfaces as an opaque mamba "nothing
                    # provides gain-core" mid-solve.
                    test -n "$(ls dist/conda/gpf-web-*.conda 2>/dev/null)" \
                        || { echo "ERROR: no gpf-web-*.conda in dist/conda/" >&2; exit 1; }
                    test -n "$(ls dist/conda/gain-core-*.conda 2>/dev/null)" \
                        || { echo "ERROR: no gain-core-*.conda in dist/conda/" >&2; exit 1; }
                '''
            }
        }

        stage('Build driver image') {
            steps {
                sh '''
                    docker build \
                        -f docs_e2e/Dockerfile \
                        -t "$DRIVER_IMAGE" \
                        docs_e2e/
                '''
            }
        }

        stage('Run pytest') {
            steps {
                script {
                    // tb-cj9-style per-agent lock: a docs-e2e
                    // run takes a single backend port + writes
                    // to the shared GRR cache. Concurrent builds
                    // on the same agent could race on the cache
                    // (GRR's atomic-rename writes are safe but
                    // we have observed flakes under load). Lock
                    // keyed by NODE_NAME, same idiom as
                    // web_e2e's Run-e2e stage. The lock MUST be
                    // taken here in `steps`, never in stage
                    // options — declarative evaluates options
                    // before agent allocation, env.NODE_NAME
                    // unbound there.
                    lock(resource: "docs-e2e-on-${env.NODE_NAME}") {
                    try {
                        String filter = params.STAGE_FILTER?.trim()
                        String pytest_k =
                            filter ? "-k '${filter}'" : ""
                        sh """
                            mkdir -p reports/docs_e2e

                            docker run --rm \\
                                -v "\$PWD:/workspace" \\
                                -v "\$GRR_CACHE_VOLUME:/grr-cache" \\
                                -e DOCS_E2E_CHANNEL=/workspace/dist/conda \\
                                -e DOCS_E2E_GRR_CACHE=/grr-cache \\
                                -w /workspace \\
                                "\$DRIVER_IMAGE" \\
                                mamba run -n driver \\
                                    pytest -v -s ${pytest_k} \\
                                        --junitxml=/workspace/reports/docs_e2e/pytest.xml \\
                                        docs_e2e/
                        """
                    } finally {
                        // archiveArtifacts in the post block
                        // picks the JUnit + any captured logs.
                        // Nothing service-specific to dump here
                        // — the suite is single-container; the
                        // wgpf log is surfaced into pytest's
                        // own stderr by the wgpf_server fixture
                        // on failure.
                        echo "Run pytest stage exiting (locked: docs-e2e-on-${env.NODE_NAME})"
                    }
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                junit(
                    allowEmptyResults: true,
                    testResults: 'reports/docs_e2e/*.xml',
                )
                archiveArtifacts(
                    artifacts: 'reports/docs_e2e/**',
                    allowEmptyArchive: true,
                    fingerprint: false,
                )
            }
        }
        // `always` above must run before these so the test-result action
        // zulipAlert() reads is already attached to the build.
        failure {
            // Wrapped in an explicit node block: a pipeline-init failure can
            // tear down the outer agent before post runs, leaving zulipSend
            // without a FilePath context.
            node('builder') {
                zulipSend(
                    topic: "${env.JOB_NAME}",
                    message: zulipAlert('FAILED', '❌'),
                )
            }
        }
        unstable {
            node('builder') {
                zulipSend(
                    topic: "${env.JOB_NAME}",
                    message: zulipAlert('UNSTABLE', '⚠️'),
                )
            }
        }
        cleanup {
            sh '''
                docker rmi "$DRIVER_IMAGE" 2>/dev/null || true
            '''
        }
    }
}
