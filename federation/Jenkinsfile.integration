// Dedicated Jenkins pipeline for the gpf-federation integration suite.
// Triggered downstream from `iossifovlab/gpf/<branch>`'s
// "Trigger federation integration" stage after Sub-projects (core +
// web tests + lint) finishes successfully. Can also be run manually
// from the Jenkins UI with explicit BRANCH_NAME / COMMIT_SHA params.
//
// Stack: federation/docker-compose-integration.yaml brings up a wdae
// backend container (entrypoint: scripts/backend/run_gpf.sh) seeded
// with a t4c8 GPF instance, and a runner container that hits the
// backend with pytest (TEST_REMOTE_HOST=http://backend:21010).

// Zulip failure alert (seqpipe/infra#105). Builds that pass say nothing.
//
// `build-status` used to receive a "Started build" message *and* a result
// message for every build of every job — 827 messages in 48h, of which 10 were
// failures — which made it unreadable, so nobody read it. Only FAILURE and
// UNSTABLE alert now, and they tag the channel so the alert actually pushes.
//
// UNSTABLE is included deliberately: lint/type gates mark the build UNSTABLE
// rather than FAILURE, so a failure-only rule would let a regression sit
// silent until the 09:00 digest (seqpipe/infra#110).
//
// Verbatim copy of the block proven in iossifovlab/gain#809 — do not
// re-derive it.
def zulipAlert(String status, String emoji) {
    String suffix = ''
    try {
        def results = currentBuild.rawBuild.getAction(
            hudson.tasks.test.AbstractTestResultAction)
        if (results != null) {
            // failCount == 0 on a red build means nothing got as far as
            // failing a test — a teardown / sidecar / agent problem rather
            // than a code break. Saying which is what decides "re-run" vs
            // "investigate" without opening Jenkins.
            suffix = results.failCount > 0
                ? " — ${results.failCount} test(s) failed"
                : ' — no failing tests (infra/teardown)'
        }
    } catch (ignored) {
        // getAction() needs a one-time In-process Script Approval
        // (seqpipe/infra#106). Until that lands the alert still fires, just
        // without the count: the reporting must never break the report.
        suffix = ''
    }
    return "@**channel** ${emoji} " +
        "[${env.JOB_NAME} ${currentBuild.displayName}](${env.BUILD_URL}) " +
        "${status}${suffix}"
}

pipeline {
    // builder = general build agents; deploy targets don't carry it
    agent { label 'builder' }

    parameters {
        string(
            name: 'BRANCH_NAME',
            defaultValue: 'master',
            description: 'Branch the upstream gpf build was ' +
                'triggered from. The pipeline checks out ' +
                'this branch unless COMMIT_SHA is set.',
        )
        string(
            name: 'COMMIT_SHA',
            defaultValue: '',
            description: 'Specific commit SHA to test (takes ' +
                'precedence over BRANCH_NAME). Empty = use ' +
                'BRANCH_NAME HEAD.',
        )
        string(
            name: 'UPSTREAM_PROJECT',
            defaultValue: '',
            description: 'Parent gpf job to inherit the gain ' +
                'wheel from (e.g. iossifovlab/gpf/master). ' +
                'Empty = manual run, fall back to gain master ' +
                'lastSuccessful.',
        )
        string(
            name: 'UPSTREAM_BUILD',
            defaultValue: '',
            description: 'Specific upstream gpf build number ' +
                'to copy the gain wheel from. Empty + non-empty ' +
                'UPSTREAM_PROJECT = lastSuccessful of that job.',
        )
    }

    options {
        timeout(time: 1, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        COMPOSE_PROJECT =
            "gpf-federation-integration-${env.BUILD_NUMBER}"
    }

    stages {
        stage('Start') {
            steps {
                script {
                    // Replace the default '#42' with '#42 <branch>'
                    // (plus '@<short-sha>' on manual COMMIT_SHA pins) so
                    // the build list shows which branch a build is for —
                    // mirrors web_e2e/Jenkinsfile.e2e. Set before any
                    // stage that can fail so it survives early aborts;
                    // Checkout refines it with the resolved commit.
                    String label = params.BRANCH_NAME
                    if (params.COMMIT_SHA?.trim()) {
                        label += " @ ${params.COMMIT_SHA.take(7)}"
                    }
                    currentBuild.displayName =
                        "#${env.BUILD_NUMBER} ${label}"
                }
            }
        }

        stage('Prepare workspace') {
            steps {
                sh '''
                    docker run --rm -v "$PWD:/wd" -w /wd alpine \
                        rm -rf reports federation/reports
                    mkdir -p reports/integration federation/reports
                    chmod 777 federation/reports
                '''
            }
        }

        stage('Checkout') {
            steps {
                script {
                    String ref = params.COMMIT_SHA?.trim() ?: \
                                 params.BRANCH_NAME
                    def scmVars = checkout([
                        $class: 'GitSCM',
                        branches: [[name: ref]],
                        userRemoteConfigs: [[
                            url: 'https://github.com/iossifovlab/gpf.git',
                        ]],
                        extensions: [[$class: 'CloneOption',
                                      shallow: true,
                                      noTags: true,
                                      depth: 1]],
                    ])
                    // Refine the build label with the actually-resolved
                    // commit — nightly triggers pass BRANCH_NAME only,
                    // no COMMIT_SHA, so this is where the sha appears.
                    currentBuild.displayName =
                        "#${env.BUILD_NUMBER} ${params.BRANCH_NAME}" +
                        " @ ${scmVars.GIT_COMMIT.take(7)}"
                }
            }
        }

        stage('Fetch gain wheel') {
            // federation/Dockerfile (since tb-eqh phase-5b)
            // installs gain-core from a wheel staged at
            // dist/gain/. This stage populates that directory
            // before the docker build below — without it the
            // `COPY dist/gain/ ./dist/gain/` step in the
            // Dockerfile fails with "/dist/gain": not found.
            //
            // Two modes mirror web_e2e/Jenkinsfile.e2e:
            //   * UPSTREAM_PROJECT set → copy dist/{core,web,
            //     gain}/*.whl from the parent gpf build (the
            //     selector pins to the exact build that
            //     assembled the gpf image when UPSTREAM_BUILD
            //     is also set, lastSuccessful() otherwise).
            //     Filter mirrors web_e2e exactly even though
            //     this Dockerfile only consumes dist/gain/ —
            //     keeps the snippet uniform across downstream
            //     jobs.
            //   * UPSTREAM_PROJECT empty (manual run) → pull
            //     gain master lastSuccessful directly. No
            //     gpf-wheel build dance: this Dockerfile
            //     builds gpf workspace members from path
            //     sources via uv sync, so dist/core / dist/web_api
            //     would be dead weight here.
            steps {
                // Stale-artifact guard: this agent's workspace persists
                // across builds and copyArtifacts only *adds* files, so
                // dist/gain/ otherwise accumulates every past gain wheel.
                // uv's --find-links then resolves gain-core to the
                // highest *version* present, which silently picks a stale
                // wheel if gain master is ever rolled back. Wipe the copy
                // targets so only this build's fetched wheel is present.
                sh 'rm -rf dist/core dist/web_api dist/gain'
                script {
                    if (params.UPSTREAM_PROJECT?.trim()) {
                        copyArtifacts(
                            filter: 'dist/core/*.whl, ' +
                                    'dist/web_api/*.whl, ' +
                                    'dist/gain/*.whl',
                            fingerprintArtifacts: true,
                            projectName: params.UPSTREAM_PROJECT,
                            selector:
                                params.UPSTREAM_BUILD?.trim()
                                    ? specific(params.UPSTREAM_BUILD)
                                    : lastSuccessful(),
                        )
                    } else {
                        copyArtifacts(
                            filter: 'dist/core/*.whl',
                            fingerprintArtifacts: true,
                            projectName: 'iossifovlab/gain/master',
                            selector: lastSuccessful(),
                            target: 'dist/gain',
                            flatten: true,
                        )
                    }
                }
                sh '''
                    ls -la dist/gain/
                    test -n "$(ls dist/gain/gain_core-*.whl 2>/dev/null)"
                '''
            }
        }

        stage('Build image') {
            steps {
                sh '''
                    docker compose \
                        -p "$COMPOSE_PROJECT" \
                        -f federation/docker-compose-integration.yaml \
                        build backend
                '''
            }
        }

        stage('Run integration tests') {
            steps {
                script {
                    try {
                        sh '''
                            TEST_RC=0
                            docker compose \
                                -p "$COMPOSE_PROJECT" \
                                -f federation/docker-compose-integration.yaml \
                                run --rm runner \
                                    || TEST_RC=$?
                            cp federation/reports/*.xml \
                                reports/integration/ 2>/dev/null || true
                            exit $TEST_RC
                        '''
                    } finally {
                        // Capture backend container logs before teardown
                        // (gpf#944). `docker compose run` only streams the
                        // runner, so a backend boot crash (run_gpf.sh:
                        // instance seed → migrate → user/app creation →
                        // runserver) otherwise surfaces as just "dependency
                        // failed to start ... exited (1)" with no traceback.
                        // Best-effort (|| true); MUST run before `down -v`
                        // removes the containers. (No mail service here,
                        // unlike rest_client.)
                        sh '''
                            docker compose \
                                -p "$COMPOSE_PROJECT" \
                                -f federation/docker-compose-integration.yaml \
                                logs --no-color backend \
                                > reports/integration/compose-backend.log \
                                2>&1 || true
                            cat reports/integration/compose-backend.log \
                                || true
                        '''
                        sh '''
                            docker compose \
                                -p "$COMPOSE_PROJECT" \
                                -f federation/docker-compose-integration.yaml \
                                down -v --remove-orphans || true
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                junit(
                    allowEmptyResults: true,
                    testResults: 'reports/integration/pytest.xml',
                )
                recordCoverage(
                    tools: [[
                        parser: 'COBERTURA',
                        pattern: 'reports/integration/coverage.xml',
                    ]],
                    id: 'federation-integration-coverage',
                    name: 'federation integration coverage',
                    skipPublishingChecks: true,
                    failOnError: false,
                )
                archiveArtifacts(
                    artifacts: 'reports/integration/*.xml, ' +
                        'reports/integration/*.log',
                    allowEmptyArchive: true,
                    fingerprint: false,
                )
            }
        }
        // `always` above must run before these so the test-result action
        // zulipAlert() reads is already attached to the build.
        failure {
            // Wrapped in an explicit node block: a pipeline-init failure can
            // tear down the outer agent before post runs, leaving zulipSend
            // without a FilePath context.
            node('builder') {
                zulipSend(
                    topic: "${env.JOB_NAME}",
                    message: zulipAlert('FAILED', '❌'),
                )
            }
        }
        unstable {
            node('builder') {
                zulipSend(
                    topic: "${env.JOB_NAME}",
                    message: zulipAlert('UNSTABLE', '⚠️'),
                )
            }
        }
        cleanup {
            sh '''
                docker rmi gpf-federation-ci:integration 2>/dev/null || true
            '''
        }
    }
}
