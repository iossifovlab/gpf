// Cron-scheduled orchestrator that rebuilds master from scratch
// and re-runs the integration jobs unconditionally. Catches
// dependency drift / silently-stale caches on quiet days.
//
// Five downstreams are exercised:
//   - iossifovlab/gpf/master              — full rebuild, lint+tests+
//                                           wheels for core + web_api +
//                                           federation + rest_client
//   - /gpf-federation-integration         — federation tests against a
//                                           freshly seeded backend
//   - /gpf-rest-client-integration        — rest_client tests against
//                                           a freshly seeded backend
//                                           + Mailpit
//   - /gpf-staging-deploy                 — wipe-and-redeploy gpf-web
//                                           on dory (iossifovlab
//                                           playground host) pinned
//                                           to the master rebuild's
//                                           BUILD_NUMBER. Gated on
//                                           the prior three stages
//                                           all succeeding — we will
//                                           NOT wipe dory to install
//                                           a known-bad build.
//   - /gpf-python-matrix                  — core + web_api pytest under
//                                           Python 3.12 / 3.13 / 3.14.
//                                           Runs beside the deploy, with
//                                           propagate:false, so its
//                                           result never gates or
//                                           delays the deploy; the job
//                                           sends its own alert
//                                           (iossifovlab/gain#2385,
//                                           decision 5).
//
// The first three stages are wrapped in `catchError` with
// buildResult: 'FAILURE', so a failure in one doesn't mask the
// others. By morning we want a single Zulip alert whose linked
// build surfaces every failing downstream, not just whichever
// broke first. The Deploy on dory stage uses a `when` gate
// instead — firing a destructive deploy after a known failure
// would be a real own-goal.
//
// Run gpf-python-matrix runs in parallel with Deploy on dory,
// behind the same `when` gate. A failed deploy does not stop the
// matrix, and the matrix does not delay the deploy. The matrix
// stage uses `catchError` with buildResult: 'SUCCESS'. Only a
// matrix job that cannot start turns that stage UNSTABLE. A red
// or aborted matrix run leaves the stage and the nightly green:
// gpf-python-matrix alerts from its own post{}. The matrix job
// bounds its own run with a 2-hour timeout.

// Zulip failure alert (seqpipe/infra#105). Builds that pass say nothing.
//
// `build-status` used to receive a "Started build" message *and* a result
// message for every build of every job — 827 messages in 48h, of which 10 were
// failures — which made it unreadable, so nobody read it. Only FAILURE and
// UNSTABLE alert now, and they tag the channel so the alert actually pushes.
//
// UNSTABLE is included deliberately: lint/type gates mark the build UNSTABLE
// rather than FAILURE, so a failure-only rule would let a regression sit
// silent until the 09:00 digest (seqpipe/infra#110).
//
// Verbatim copy of the block proven in iossifovlab/gain#809 — do not
// re-derive it.
def zulipAlert(String status, String emoji) {
    String suffix = ''
    try {
        def results = currentBuild.rawBuild.getAction(
            hudson.tasks.test.AbstractTestResultAction)
        if (results != null) {
            // failCount == 0 on a red build means nothing got as far as
            // failing a test — a teardown / sidecar / agent problem rather
            // than a code break. Saying which is what decides "re-run" vs
            // "investigate" without opening Jenkins.
            suffix = results.failCount > 0
                ? " — ${results.failCount} test(s) failed"
                : ' — no failing tests (infra/teardown)'
        }
    } catch (ignored) {
        // getAction() needs a one-time In-process Script Approval
        // (seqpipe/infra#106). Until that lands the alert still fires, just
        // without the count: the reporting must never break the report.
        suffix = ''
    }
    return "@**channel** ${emoji} " +
        "[${env.JOB_NAME} ${currentBuild.displayName}](${env.BUILD_URL}) " +
        "${status}${suffix}"
}

pipeline {
    // builder = general build agents; deploy targets (dory) don't
    // carry it — this pipeline wipes and redeploys dory downstream.
    agent { label 'builder' }

    options {
        // Generous: a cold master rebuild + both integration suites
        // + a wipe-and-redeploy on dory can comfortably reach 100
        // minutes. The python matrix runs beside the deploy and
        // takes at most 2 hours, the timeout of gpf-python-matrix
        // itself. 4 hours leaves headroom for a slow/contended night
        // without false-alarming.
        timeout(time: 4, unit: 'HOURS')
        // 40 keeps ~6 weeks of nightlies for trend analysis without
        // bloating the controller's disk.
        buildDiscarder(logRotator(numToKeepStr: '40'))
    }

    // tb-7e7: cron lives in jenkins-jobs/nightly.groovy (the Job
    // DSL), not here. A `triggers { cron(...) }` block in this
    // Jenkinsfile only registers AFTER the pipeline has run once,
    // and gpf-seed re-applies the DSL on every master push —
    // wiping the registration before 02:00 UTC arrives. Putting the
    // cron in the DSL means each seed run re-asserts it explicitly.

    stages {
        stage('Rebuild master') {
            steps {
                catchError(buildResult: 'FAILURE',
                           stageResult: 'FAILURE') {
                    script {
                        // Capture the downstream build's BUILD_NUMBER
                        // so the `Deploy on dory` stage below can pin
                        // gpf-web's image tag exactly to the image
                        // this nightly just validated. Without the
                        // pin, a regular master push landing during
                        // the ~100-min nightly window would race —
                        // dory would deploy whatever :latest points
                        // at when the deploy stage runs, NOT what we
                        // tested.
                        env.MASTER_REBUILD_NUMBER = build(
                            job: 'iossifovlab/gpf/master',
                            wait: true,
                            propagate: true,
                        ).number.toString()
                    }
                }
            }
        }

        stage('Run gpf-federation-integration') {
            steps {
                catchError(buildResult: 'FAILURE',
                           stageResult: 'FAILURE') {
                    build(
                        job: '/gpf-federation-integration',
                        wait: true,
                        propagate: true,
                    )
                }
            }
        }

        stage('Run gpf-rest-client-integration') {
            steps {
                catchError(buildResult: 'FAILURE',
                           stageResult: 'FAILURE') {
                    build(
                        job: '/gpf-rest-client-integration',
                        wait: true,
                        propagate: true,
                    )
                }
            }
        }

        // The deploy and the python matrix run side by side. The
        // matrix does not hold the deploy, and a failed deploy
        // does not stop the matrix. failFast stays false, so
        // each branch runs to its end.
        stage('Deploy and python matrix') {
            parallel {
                stage('Deploy on dory') {
                    // Wipes /opt/gpf-web/ on dory and redeploys the gpf-web
                    // stack pinned to the master rebuild's BUILD_NUMBER.
                    // NOT wrapped in catchError — if the deploy itself
                    // fails after the gate passed, the nightly turns
                    // FAILURE and alerts. The matrix branch still runs
                    // to its end. The deploy job has its own rescue/rollback,
                    // so on its own internal failure dory rolls back to the
                    // previous image automatically.
                    when {
                        expression {
                            currentBuild.currentResult == 'SUCCESS'
                        }
                    }
                    steps {
                        build(
                            job: 'gpf-staging-deploy',
                            wait: true,
                            propagate: true,
                            parameters: [
                                booleanParam(
                                    name: 'WIPE_FIRST',
                                    value: true,
                                ),
                                string(
                                    name: 'IMAGE_TAG',
                                    value: env.MASTER_REBUILD_NUMBER,
                                ),
                            ],
                        )
                    }
                }

                stage('Run gpf-python-matrix') {
                    // Runs beside `Deploy on dory`: the nightly does not
                    // hold the deploy for the matrix run (up to 2 hours),
                    // and a failed deploy does not stop the matrix.
                    // The same `when` gate as the deploy skips the matrix
                    // when an earlier stage failed, so the FAILED alert
                    // does not wait for a matrix run on a broken master.
                    //
                    // propagate: false: a red matrix must not change this
                    // build's result (iossifovlab/gain#2385, decision 5).
                    // Both branches start together, so the matrix result
                    // never reaches the `when` gate of the deploy. The
                    // proof of propagate: false is that a red matrix run
                    // leaves the nightly SUCCESS. That differs on purpose
                    // from gain, where a red matrix stops the deploy.
                    // gpf-python-matrix reports its own red, unstable or
                    // aborted result with a Zulip alert (topic: nightly).
                    //
                    // No `timeout` wraps the build step here. A timeout that
                    // fires interrupts this build, and catchError then marks
                    // the whole nightly ABORTED for a matrix result that must
                    // not change it.
                    // gpf-python-matrix bounds its own run with a 2-hour
                    // timeout instead: an aborted matrix run comes back as a
                    // run object, and the build step does not throw.
                    //
                    // The build step throws only when the matrix job cannot
                    // start. The catch block sends a Zulip alert, because the
                    // nightly result stays SUCCESS and its post{} stays silent.
                    // catchError(buildResult: 'SUCCESS') keeps that result,
                    // and only the stage turns UNSTABLE. A red or aborted
                    // matrix run leaves this stage green.
                    when {
                        expression {
                            currentBuild.currentResult == 'SUCCESS'
                        }
                    }
                    steps {
                        catchError(buildResult: 'SUCCESS',
                                   stageResult: 'UNSTABLE') {
                            script {
                                try {
                                    def matrixRun = build(
                                        job: '/gpf-python-matrix',
                                        wait: true,
                                        propagate: false,
                                        parameters: [
                                            string(name: 'BRANCH_NAME',
                                                   value: 'master'),
                                        ],
                                    )
                                    echo "gpf-python-matrix " +
                                        "#${matrixRun.number}: " +
                                        "${matrixRun.result} " +
                                        "(does not gate the deploy)"
                                } catch (hudson.AbortException e) {
                                    zulipSend(
                                        topic: 'nightly',
                                        message: "@**channel** ⚠️ " +
                                            "[${env.JOB_NAME} " +
                                            "${currentBuild.displayName}]" +
                                            "(${env.BUILD_URL}) " +
                                            "gpf-python-matrix did not " +
                                            "start: ${e.message}",
                                    )
                                    throw e
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        failure {
            // Wrapped in an explicit node block: a pipeline-init
            // failure can tear down the outer agent before post
            // runs, leaving zulipSend without a FilePath context.
            node('builder') {
                zulipSend(
                    topic: 'nightly',
                    message: zulipAlert('FAILED', '❌'),
                )
            }
        }
        // UNSTABLE now alerts too (seqpipe/infra#105): lint/type gates
        // mark the build UNSTABLE rather than FAILURE, so a
        // failure-only rule would let a regression sit silent
        // overnight.
        unstable {
            node('builder') {
                zulipSend(
                    topic: 'nightly',
                    message: zulipAlert('UNSTABLE', '⚠️'),
                )
            }
        }
    }
}
